<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>example</groupId>
  <artifactId>godot-library-consumer</artifactId>
  <version>1</version>
  <properties>
    <godot.platform>win</godot.platform>
  </properties>
  <profiles>
    <profile>
      <id>staged-release</id>
      <activation><property><name>godot.repository</name></property></activation>
      <repositories>
        <repository>
          <id>godot-runtime</id>
          <url>${godot.repository}</url>
        </repository>
      </repositories>
    </profile>
  </profiles>
  <dependencies>
    <dependency><groupId>io.vproxy</groupId><artifactId>godot-jfx-controls</artifactId><version>${godot.version}</version></dependency>
    <dependency><groupId>io.vproxy</groupId><artifactId>godot-jfx-media</artifactId><version>${godot.version}</version></dependency>
    <dependency><groupId>io.vproxy</groupId><artifactId>godot-jfx-swing</artifactId><version>${godot.version}</version></dependency>
    <dependency><groupId>io.vproxy</groupId><artifactId>godot-jfx-fxml</artifactId><version>${godot.version}</version></dependency>
    <dependency><groupId>io.vproxy</groupId><artifactId>godot-jfx-graphics</artifactId><version>${godot.version}</version><classifier>${godot.platform}</classifier></dependency>
    <dependency><groupId>io.vproxy</groupId><artifactId>godot-jfx-media</artifactId><version>${godot.version}</version><classifier>${godot.platform}</classifier></dependency>
  </dependencies>
</project>
