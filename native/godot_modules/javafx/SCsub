Import("env")
Import("env_modules")

import os

env_javafx = env_modules.Clone()
# JNI must translate STL allocation failure into a Java exception. Keep this
# scoped to the module; Godot's other translation units retain their defaults.
if env_javafx.msvc:
    env_javafx["CPPDEFINES"] = [
        define for define in env_javafx["CPPDEFINES"]
        if not (isinstance(define, tuple) and define[0] == "_HAS_EXCEPTIONS")
    ]
    env_javafx.Append(CXXFLAGS=["/EHsc"], CPPDEFINES=[("_HAS_EXCEPTIONS", 1)])
else:
    env_javafx["CXXFLAGS"] = [flag for flag in env_javafx["CXXFLAGS"] if flag != "-fno-exceptions"]
    env_javafx.Append(CXXFLAGS=["-fexceptions"])
jdk = os.environ.get("JAVA_HOME", "")
if not os.path.isfile(os.path.join(jdk, "include", "jni.h")):
    raise RuntimeError("JavaFX module requires JAVA_HOME pointing to an installed JDK")
jni_platform_dir = "darwin" if env["platform"] == "macos" else "win32"
env_javafx.Append(CPPPATH=[os.path.join(jdk, "include"), os.path.join(jdk, "include", jni_platform_dir)])
env_javafx.add_source_files(env.modules_sources, "*.cpp")
if env["platform"] == "windows" and env["library_type"] == "shared_library" and env.msvc:
    # JNI enters this archive member by name from Java.
    env.Append(LINKFLAGS=["/INCLUDE:Java_com_sun_javafx_tk_godot_LibraryGodotEngine_run"])
if env["platform"] == "macos":
    env_javafx.add_source_files(env.modules_sources, "*.mm")
    if env["library_type"] == "shared_library":
        env.Append(LINKFLAGS=["-Wl,-u,_Java_com_sun_javafx_tk_godot_GodotSceneFixture_run", "-Wl,-u,_Java_com_sun_javafx_tk_godot_GodotSceneFixture_runOnAppKitThread"])
        for symbol in ("run", "mountScenePack", "requestStop", "runOnAppKitThread"):
            env.Append(LINKFLAGS=["-Wl,-u,_Java_com_sun_javafx_tk_godot_LibraryGodotEngine_" + symbol])
